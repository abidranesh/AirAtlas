# Copy to .env (git-ignored). In CI these live in GitHub Actions secrets; in web/ they live in Vercel env vars.

# data.gov.in: sign up at https://www.data.gov.in/ → My Account → "Generate API Key"
DATA_GOV_IN_API_KEY=

# OpenAQ v3: sign up at https://explore.openaq.org/register → account settings → API key
OPENAQ_API_KEY=

# NASA FIRMS: request at https://firms.modaps.eosdis.nasa.gov/api/map_key/ (emailed instantly)
FIRMS_MAP_KEY=

# Neon Postgres (Phase 3): https://console.neon.tech/signup → create project "airatlas" → Connection string
DATABASE_URL=
